{
  "name": "the-unique-hope",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "admin:reset-password": "tsx --env-file=.env scripts/admin-reset-password.ts",
    "build": "next build",
    "check": "npm run lint && npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "import:student-inquiries": "tsx --env-file=.env scripts/import-student-inquiries.ts",
    "import:student-inquiries:check": "tsx --env-file=.env scripts/import-student-inquiries.ts --dry-run",
    "lint": "SKIP_ENV_VALIDATION=1 eslint src scripts tests drizzle.config.ts next.config.js eslint.config.js vitest.config.ts playwright.config.ts --ext .ts,.tsx,.js",
    "lint:fix": "SKIP_ENV_VALIDATION=1 eslint src scripts tests drizzle.config.ts next.config.js eslint.config.js vitest.config.ts playwright.config.ts --ext .ts,.tsx,.js --fix",
    "preview": "next build && next start",
    "release:check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "recovery:backfill-phones": "tsx --env-file=.env scripts/backfill-recovery-phones.ts",
    "reset:fake-evidence": "tsx scripts/reset-fake-evidence.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "web-push:check": "tsx --env-file=.env scripts/prepare-web-push.ts --check",
    "web-push:check:production": "tsx --env-file=.env scripts/prepare-web-push.ts --check --production",
    "web-push:prepare": "tsx scripts/prepare-web-push.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.100.7",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.1",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "postgres": "^3.4.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "web-push": "^3.6.7",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.3",
    "eslint": "^10.2.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "undici": "^6.24.0",
    "postcss": "$postcss"
  },
  "packageManager": "npm@11.13.0"
}
