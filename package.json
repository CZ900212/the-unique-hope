{
  "name": "the-unique-hope",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:reset-password": "tsx --env-file=.env scripts/admin-reset-password.ts",
    "build": "next build",
    "check": "npm run lint && npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "SKIP_ENV_VALIDATION=1 eslint src scripts tests drizzle.config.ts next.config.js eslint.config.js vitest.config.ts playwright.config.ts --ext .ts,.tsx,.js",
    "lint:fix": "SKIP_ENV_VALIDATION=1 eslint src scripts tests drizzle.config.ts next.config.js eslint.config.js vitest.config.ts playwright.config.ts --ext .ts,.tsx,.js --fix",
    "migrate:instant": "tsx --env-file=.env scripts/migrate-instant.ts",
    "preview": "next build && next start",
    "reset:fake-evidence": "tsx scripts/reset-fake-evidence.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.2",
    "@instantdb/admin": "^0.18.7",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@vercel/blob": "^2.3.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "file-type": "^20.5.0",
    "lucide-react": "^0.511.0",
    "next": "^15.2.3",
    "next-auth": "5.0.0-beta.25",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@11.6.0"
}
